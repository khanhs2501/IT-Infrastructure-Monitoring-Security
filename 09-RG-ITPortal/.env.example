# ROYAL IT Portal v1.7.0 — CONFIGURATION TEMPLATE
# Copy to .env only when creating a NEW configuration. For an existing working portal,
# keep the current .env and add/update keys as documented in docs/CONFIGURATION.md.
# Never commit or send the real .env. Keep every secret local and rotate credentials exposed in chat.

# --- HTTP, reverse proxy, SQLite and audit retention ---
# PORT in this package defaults to 3000 for a non-admin local startup; set 80 only if available. Choose an unused port if another service already binds it.
PORT="80"
# Keep false unless Portal is behind a trusted reverse proxy. Use a narrowly scoped value, e.g. loopback or 1.
TRUST_PROXY="false"
# true only when the browser reaches the portal over HTTPS; for plain HTTP lab setups use false.
COOKIE_SECURE="false"
# Optional absolute SQLite file path. If empty, it is created beside server.js regardless of service working directory.
DB_PATH=""
# Audit log retention period in days (1–3650).
AUDIT_RETENTION_DAYS="180"

# --- Portal session ---
# Required for startup: set a random secret of at least 32 characters in .env.
SESSION_SECRET=""

# --- Zabbix API ---
ZABBIX_URL=http://zabbix.example.invalid/api_jsonrpc.php
ZABBIX_TOKEN=YOUR_ZABBIX_API_TOKEN
ZABBIX_HOST_WIN=WINDOWS_HOSTNAME
ZABBIX_HOST_LINUX=LINUX_HOSTNAME
ASSET_ZABBIX_HOSTS=WINDOWS_HOSTNAME,LINUX_HOSTNAME

# --- Wazuh Indexer ---
INDEXER_URL=https://wazuh-indexer.example.invalid:9200
INDEXER_USER=YOUR_INDEXER_USER
INDEXER_PASS=YOUR_INDEXER_PASSWORD
# false means skip TLS certificate verification; lab-only for a self-signed certificate.
# Use true in production after trusting the Indexer certificate.
INDEXER_TLS_REJECT_UNAUTHORIZED="false"
WAZUH_SCOPE_AGENTS=WINDOWS_HOSTNAME,LINUX_HOSTNAME

# --- LINUX01 SSH / Docker ---
LINUX_SSH_HOST=linux.example.invalid
LINUX_SSH_PORT="22"
LINUX_SSH_USER=YOUR_SSH_USER
LINUX_SSH_PASS=YOUR_SSH_PASSWORD
DOCKER_PROTECTED=CONTAINER_1,CONTAINER_2

# --- pfSense SSH ---
# Preserve the previously supplied working target; change only if verified in pfSense.
PFSENSE_SSH_HOST=firewall.example.invalid
PFSENSE_SSH_PORT="22"
PFSENSE_SSH_USER=YOUR_PFSENSE_USER
PFSENSE_SSH_PASS=YOUR_PFSENSE_PASSWORD

# --- Active Directory / Computer Management ---
# DEPT_PARENT_OU is the OU NAME (not DN), currently a root-level OU named Departments.
DEPT_PARENT_OU=OU=Departments,DC=example,DC=invalid
DEPT_EXCLUDE_OU=OU=Protected,DC=example,DC=invalid
# OU names permitted for computer management operations; Client_Computers is root-level.
COMPUTER_MANAGED_OUS=OU=Computers,DC=example,DC=invalid
COMPUTER_PROTECTED_NAMES=EXAMPLE-DC

# --- Kubernetes monitoring (optional; leave empty if unused) ---
K8S_API_URL=""
K8S_BEARER_TOKEN=""
K8S_TLS_REJECT_UNAUTHORIZED="true"

# --- AWS / Cloud monitoring (optional; leave disabled if unused) ---
CLOUD_PROVIDER="none"
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_SESSION_TOKEN=""

# --- Đăng nhập & phiên làm việc (v1.7.0) ---
# COOKIE_SECURE ở trên: để "auto" (hoặc trống) nếu muốn Portal tự bật cờ Secure chỉ khi truy cập bằng HTTPS.
# Thời gian sống của phiên (giờ, 1–168). Phiên được lưu trong SQLite nên KHÔNG mất khi restart service.
SESSION_HOURS="12"
# Chống dò mật khẩu theo TỪNG TÀI KHOẢN (không còn khóa chung cả IP): sai quá LOGIN_MAX_ATTEMPTS lần trong LOGIN_WINDOW_MINUTES phút thì tạm chặn tài khoản đó.
# Đặt thấp hơn ngưỡng khóa tài khoản (Account lockout threshold) của domain để Portal không làm AD khóa Administrator.
LOGIN_MAX_ATTEMPTS="8"
LOGIN_WINDOW_MINUTES="10"
LOGIN_IP_MAX_ATTEMPTS="120"
# true: báo rõ lý do khi AD từ chối (tài khoản bị khóa / vô hiệu hóa / hết hạn mật khẩu). false: luôn báo chung "sai tài khoản hoặc mật khẩu".
LOGIN_VERBOSE_ERRORS="true"
# Nhóm AD quyết định vai trò (khớp tuyệt đối tên nhóm, phân tách bằng dấu phẩy).
SUPER_ADMIN_GROUPS=YOUR_ADMIN_GROUP
IT_STAFF_GROUPS=YOUR_IT_GROUP
# Origin bổ sung được phép gọi API ghi (hiếm khi cần), ví dụ https://portal.example.invalid
ALLOWED_ORIGINS=""

